<Window x:Class="ShabarinathFloatingPenTool.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Border Background="#F21C1C1E"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="7">
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,5">
                <TextBlock x:Name="DragHandle"
                           Text="⋮⋮"
                           Foreground="White"
                           FontSize="16"
                           Margin="2,0,8,0"
                           MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"/>
                <TextBlock x:Name="ToolLabel"
                           Text="Cursor"
                           Foreground="White"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Button Content="⋯" Width="32" Height="30" Margin="2" Click="More_Click"/>
                <Button Content="×" Width="32" Height="30" Margin="2" Click="Close_Click"/>
            </DockPanel>

            <UniformGrid Columns="4" Rows="2">
                <Button Tag="Cursor" Content="↖" ToolTip="Cursor" Width="38" Height="36" Margin="2" Click="Tool_Click"/>
                <Button Tag="Pen" Content="✎" ToolTip="Pen" Width="38" Height="36" Margin="2" Click="Tool_Click"/>
                <Button Tag="Brush" Content="▰" ToolTip="Brush" Width="38" Height="36" Margin="2" Click="Tool_Click"/>
                <Button Tag="Eraser" Content="⌫" ToolTip="Eraser" Width="38" Height="36" Margin="2" Click="Tool_Click"/>
                <Button Tag="Line" Content="╱" ToolTip="Line" Width="38" Height="36" Margin="2" Click="Tool_Click"/>
                <Button Tag="Rectangle" Content="▭" ToolTip="Rectangle" Width="38" Height="36" Margin="2" Click="Tool_Click"/>
                <Button Tag="Square" Content="□" ToolTip="Square" Width="38" Height="36" Margin="2" Click="Tool_Click"/>
                <Button Tag="Circle" Content="○" ToolTip="Circle" Width="38" Height="36" Margin="2" Click="Tool_Click"/>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="↶" ToolTip="Undo" Width="38" Height="36" Margin="2" Click="Undo_Click"/>
                <Button Content="↷" ToolTip="Redo" Width="38" Height="36" Margin="2" Click="Redo_Click"/>
                <Button Content="🗑" ToolTip="Clear" Width="38" Height="36" Margin="2" Click="Clear_Click"/>
                <Button x:Name="ColorButton" Content="●" Foreground="Red" ToolTip="Color" Width="38" Height="36" Margin="2" Click="Color_Click"/>
            </StackPanel>

            <StackPanel x:Name="MorePanel" Visibility="Collapsed" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Size" Foreground="White" VerticalAlignment="Center" Margin="4"/>
                    <ComboBox x:Name="SizeBox" Width="80" SelectionChanged="SizeBox_SelectionChanged">
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4" IsSelected="True"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="8"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="24"/>
                        <ComboBoxItem Content="32"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>